        function logJarvis(message, color = 'text-cyan-400') {
            const logContainer = document.getElementById('jarvis-log');
            if (!logContainer) return;
            const entry = document.createElement('div');
            entry.className = `${color} text-[11px] font-mono`;
            entry.innerHTML = `> ${message}`;
            logContainer.prepend(entry);

            if (logContainer.children.length > 8) {
                logContainer.removeChild(logContainer.lastChild);
            }
        }

        function initThreeJS() {
            const container = document.getElementById('game-canvas');
            
            // Scene Setup
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x030712, 0.012);

            // Camera Setup
            camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 3, 10);

            // Renderer Setup
            renderer = new THREE.WebGLRenderer({ canvas: container, antialias: true, alpha: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;

            // Lighting Setup
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
            dirLight.position.set(10, 30, 20);
            scene.add(dirLight);

            // Create Player Iron Man Suit
            createIronManSuit();

            // Build Initial Environment (City Canyon)
            buildCityEnvironment();

            // Create Speed Lines Effect
            createSpeedLines();

            // Event Listeners
            window.addEventListener('resize', onWindowResize);
            window.addEventListener('mousemove', onMouseMove);
            window.addEventListener('touchmove', onTouchMove, { passive: true });
            window.addEventListener('mousedown', fireRepulsor);
            window.addEventListener('keydown', (e) => {
                if (e.code === 'Space') fireRepulsor();
            });

            document.getElementById('start-btn').addEventListener('click', startGame);
            document.getElementById('restart-btn').addEventListener('click', restartGame);
            document.getElementById('pause-btn').addEventListener('click', togglePause);

            // Animation Loop Start
            animate();
        }

        function createIronManSuit() {
            suitBodyGroup = new THREE.Group();
            const theme = SUIT_THEMES[currentThemeKey];

            const mainMat = new THREE.MeshStandardMaterial({
                color: theme.primary,
                roughness: 0.2,
                metalness: 0.8
            });

            const accentMat = new THREE.MeshStandardMaterial({
                color: theme.secondary,
                roughness: 0.2,
                metalness: 0.9
            });

            const glowMat = new THREE.MeshBasicMaterial({
                color: theme.glow
            });

            // Torso
            const chestGeo = new THREE.BoxGeometry(1.2, 1.6, 0.8);
            const chest = new THREE.Mesh(chestGeo, mainMat);
            chest.position.y = 0.8;
            suitBodyGroup.add(chest);

            // Arc Reactor (Chest Core)
            const arcGeo = new THREE.CylinderGeometry(0.2, 0.2, 0.1, 16);
            arcGeo.rotateX(Math.PI / 2);
            const arcReactor = new THREE.Mesh(arcGeo, glowMat);
            arcReactor.position.set(0, 1.0, 0.42);
            suitBodyGroup.add(arcReactor);

            // Head / Helmet
            const headGeo = new THREE.BoxGeometry(0.7, 0.8, 0.7);
            const head = new THREE.Mesh(headGeo, mainMat);
            head.position.y = 2.0;

            // Faceplate
            const faceGeo = new THREE.BoxGeometry(0.55, 0.65, 0.1);
            const faceplate = new THREE.Mesh(faceGeo, accentMat);
            faceplate.position.set(0, 2.0, 0.35);
            suitBodyGroup.add(head);
            suitBodyGroup.add(faceplate);

            // Eyes Glow
            const eyeGeo = new THREE.BoxGeometry(0.4, 0.08, 0.05);
            const eyes = new THREE.Mesh(eyeGeo, glowMat);
            eyes.position.set(0, 2.1, 0.38);
            suitBodyGroup.add(eyes);

            // Shoulders & Arms
            const shoulderGeo = new THREE.SphereGeometry(0.4, 16, 16);
            const leftShoulder = new THREE.Mesh(shoulderGeo, accentMat);
            leftShoulder.position.set(-0.9, 1.3, 0);
            const rightShoulder = new THREE.Mesh(shoulderGeo, accentMat);
            rightShoulder.position.set(0.9, 1.3, 0);
            suitBodyGroup.add(leftShoulder);
            suitBodyGroup.add(rightShoulder);

            // Repulsor Palms Glow
            handRepulsors = [];
            const repulsorGeo = new THREE.SphereGeometry(0.12, 12, 12);
            const leftRepulsor = new THREE.Mesh(repulsorGeo, glowMat);
            leftRepulsor.position.set(-1.0, 0.5, 0.6);
            const rightRepulsor = new THREE.Mesh(repulsorGeo, glowMat);
            rightRepulsor.position.set(1.0, 0.5, 0.6);
            suitBodyGroup.add(leftRepulsor);
            suitBodyGroup.add(rightRepulsor);
            handRepulsors.push(leftRepulsor, rightRepulsor);

            // Legs / Thrusters
            const legGeo = new THREE.CylinderGeometry(0.25, 0.2, 1.4, 12);
            const leftLeg = new THREE.Mesh(legGeo, mainMat);
            leftLeg.position.set(-0.35, -0.6, 0);
            const rightLeg = new THREE.Mesh(legGeo, mainMat);
            rightLeg.position.set(0.35, -0.6, 0);
            suitBodyGroup.add(leftLeg);
            suitBodyGroup.add(rightLeg);

            // Boot Thrusters Glow
            const bootGeo = new THREE.CylinderGeometry(0.15, 0.05, 0.2, 12);
            const bootGlow1 = new THREE.Mesh(bootGeo, glowMat);
            bootGlow1.position.set(-0.35, -1.35, 0);
            const bootGlow2 = new THREE.Mesh(bootGeo, glowMat);
            bootGlow2.position.set(0.35, -1.35, 0);
            suitBodyGroup.add(bootGlow1);
            suitBodyGroup.add(bootGlow2);

            // Scale & Position Whole Suit
            suitBodyGroup.scale.set(0.9, 0.9, 0.9);
            suitBodyGroup.position.set(0, -1, 4);
            ironManSuit = suitBodyGroup;
            scene.add(ironManSuit);
        }

        function selectTheme(key) {
            if (!SUIT_THEMES[key]) return;
            currentThemeKey = key;
            document.querySelectorAll('.theme-card').forEach(card => {
                if (card.dataset.theme === key) {
                    card.classList.add('border-amber-500/80', 'bg-slate-800', 'shadow-[0_0_15px_rgba(245,158,11,0.3)]');
                    card.classList.remove('border-slate-700');
                } else {
                    card.classList.remove('border-amber-500/80', 'bg-slate-800', 'shadow-[0_0_15px_rgba(245,158,11,0.3)]');
                    card.classList.add('border-slate-700');
                }
            });

            if (ironManSuit) {
                scene.remove(ironManSuit);
                createIronManSuit();
            }

            const theme = SUIT_THEMES[key];
            document.getElementById('suit-name-tag').innerText = theme.name;
            logJarvis(`Armor suit configuration loaded: ${theme.name}`);
        }

        function buildCityEnvironment() {
            const buildingGeo = new THREE.BoxGeometry(1, 1, 1);

            for (let i = 0; i < 40; i++) {
                spawnBuilding(buildingGeo, -300 + i * 15);
            }
        }

        function spawnBuilding(geo, zPos) {
            const theme = SUIT_THEMES[currentThemeKey];
            const isLeft = Math.random() > 0.5;
            const xPos = isLeft ? -18 - Math.random() * 10 : 18 + Math.random() * 10;
            const height = 25 + Math.random() * 45;

            const mat = new THREE.MeshStandardMaterial({
                color: Math.random() > 0.5 ? theme.cityDark : theme.cityLight,
                roughness: 0.4,
                metalness: 0.6
            });

            const building = new THREE.Mesh(geo, mat);
            building.scale.set(12 + Math.random() * 6, height, 12);
            building.position.set(xPos, height / 2 - 10, zPos);
            scene.add(building);
            buildings.push(building);
        }

        function createSpeedLines() {
            const count = 120;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 6);

            for (let i = 0; i < count; i++) {
                const x = (Math.random() - 0.5) * 40;
                const y = (Math.random() - 0.5) * 25;
                const z = -Math.random() * 150;

                positions[i * 6] = x;
                positions[i * 6 + 1] = y;
                positions[i * 6 + 2] = z;

                positions[i * 6 + 3] = x;
                positions[i * 6 + 4] = y;
                positions[i * 6 + 5] = z - 4; // line tail
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const material = new THREE.LineBasicMaterial({
                color: 0x38bdf8,
                transparent: true,
                opacity: 0.35
            });

            speedLinesGroup = new THREE.LineSegments(geometry, material);
            scene.add(speedLinesGroup);
        }

        function spawnGameElements() {
            if (!gameActive || isPaused) return;

            // Spawn Drone / Obstacle
            if (Math.random() < 0.04) {
                const obsGeo = new THREE.OctahedronGeometry(1.2 + Math.random() * 0.5);
                const obsMat = new THREE.MeshStandardMaterial({
                    color: 0xef4444,
                    metalness: 0.8,
                    roughness: 0.2,
                    emissive: 0x991b1b
                });
                const obstacle = new THREE.Mesh(obsGeo, obsMat);
                obstacle.position.set(
                    (Math.random() - 0.5) * FLIGHT_BOUNDS_X * 1.8,
                    (Math.random() - 0.5) * FLIGHT_BOUNDS_Y * 1.6 + 1,
                    -180
                );
                obstacle.rotation.set(Math.random(), Math.random(), Math.random());
                scene.add(obstacle);
                obstacles.push(obstacle);
            }

            // Spawn Arc Energy Core
            if (Math.random() < 0.03) {
                const coreGeo = new THREE.IcosahedronGeometry(0.8, 1);
                const coreMat = new THREE.MeshStandardMaterial({
                    color: 0xf59e0b,
                    emissive: 0xd97706,
                    metalness: 0.9,
                    roughness: 0.1
                });
                const core = new THREE.Mesh(coreGeo, coreMat);
                core.position.set(
                    (Math.random() - 0.5) * FLIGHT_BOUNDS_X * 1.6,
                    (Math.random() - 0.5) * FLIGHT_BOUNDS_Y * 1.4 + 1,
                    -180
                );
                scene.add(core);
                energyCores.push(core);
            }
        }

        function fireRepulsor() {
            if (!gameActive || isPaused || repulsorCooldown > 0) return;

            initAudio();
            playRepulsorSound();

            // Repulsor Blast Projectiles from hands
            const theme = SUIT_THEMES[currentThemeKey];
            const projGeo = new THREE.SphereGeometry(0.35, 12, 12);
            const projMat = new THREE.MeshBasicMaterial({ color: theme.glow });

            handRepulsors.forEach(repulsor => {
                const proj = new THREE.Mesh(projGeo, projMat);
                const worldPos = new THREE.Vector3();
                repulsor.getWorldPosition(worldPos);

                proj.position.copy(worldPos);
                scene.add(proj);
                projectiles.push(proj);
            });

            // Screen Flash Feedback
            const flash = document.getElementById('flash-overlay');
            flash.className = 'absolute inset-0 pointer-events-none z-10 repulsor-flash';
            setTimeout(() => { flash.className = 'absolute inset-0 pointer-events-none z-10'; }, 150);

            // Deplete slight energy for shooting
            powerEnergy = Math.max(0, powerEnergy - 3);
            repulsorCooldown = 12; // Frames cooldown
        }

        function createExplosion(pos, colorHex = 0xef4444) {
            playExplosionSound();
            const count = 25;
            const pGeo = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 3);
            const velocities = [];

            for (let i = 0; i < count; i++) {
                positions[i * 3] = pos.x;
                positions[i * 3 + 1] = pos.y;
                positions[i * 3 + 2] = pos.z;

                velocities.push(new THREE.Vector3(
                    (Math.random() - 0.5) * 0.8,
                    (Math.random() - 0.5) * 0.8,
                    (Math.random() - 0.5) * 0.8
                ));
            }

            pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const pMat = new THREE.PointsMaterial({
                color: colorHex,
                size: 0.4,
                transparent: true,
                opacity: 1
            });

            const pSystem = new THREE.Points(pGeo, pMat);
            scene.add(pSystem);
            particleSystems.push({ system: pSystem, velocities: velocities, life: 1.0 });
        }

        function onMouseMove(event) {
            mouseX = (event.clientX / window.innerWidth) * 2 - 1;
            mouseY = -(event.clientY / window.innerHeight) * 2 + 1;

            targetX = mouseX * FLIGHT_BOUNDS_X;
            targetY = mouseY * FLIGHT_BOUNDS_Y;

            // Move Crosshair UI
            const crosshair = document.getElementById('crosshair');
            if (crosshair) {
                crosshair.style.left = `${event.clientX}px`;
                crosshair.style.top = `${event.clientY}px`;
            }
        }

        function onTouchMove(event) {
            if (event.touches.length > 0) {
                const touch = event.touches[0];
                mouseX = (touch.clientX / window.innerWidth) * 2 - 1;
                mouseY = -(touch.clientY / window.innerHeight) * 2 + 1;
                targetX = mouseX * FLIGHT_BOUNDS_X;
                targetY = mouseY * FLIGHT_BOUNDS_Y;
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            if (gameActive && !isPaused) {
                // Update Distance Score & Cooldowns
                distanceScore += Math.round(GAME_SPEED * 2);
                document.getElementById('score-val').innerText = `${distanceScore} m`;

                if (repulsorCooldown > 0) repulsorCooldown--;
                document.getElementById('repulsor-status').innerText = repulsorCooldown === 0 ? 'READY' : 'CHARGING';
                document.getElementById('repulsor-status').className = repulsorCooldown === 0 ? 'text-xs font-hud text-cyan-400 font-bold' : 'text-xs font-hud text-amber-400 font-bold';

                // Energy Passive Drain
                powerEnergy = Math.max(0, powerEnergy - 0.03);
                document.getElementById('power-bar').style.width = `${powerEnergy}%`;
                document.getElementById('power-val').innerText = `${Math.round(powerEnergy)}%`;

                if (powerEnergy <= 0) {
                    takeDamage(100); // Out of power crash
                }

                // Smooth Iron Man Suit Flight Steering & Banking
                ironManSuit.position.x += (targetX - ironManSuit.position.x) * 0.08;
                ironManSuit.position.y += (targetY - ironManSuit.position.y) * 0.08;

                // Roll banking rotation based on horizontal velocity
                const rollAngle = (targetX - ironManSuit.position.x) * -0.06;
                const pitchAngle = (targetY - ironManSuit.position.y) * 0.03;
                ironManSuit.rotation.z = rollAngle;
                ironManSuit.rotation.x = pitchAngle;

                // Camera follow tilt
                camera.position.x = ironManSuit.position.x * 0.3;
                camera.position.y = ironManSuit.position.y * 0.3 + 3;

                // Move Buildings (Endless Loop)
                buildings.forEach(b => {
                    b.position.z += GAME_SPEED * 4;
                    if (b.position.z > 20) {
                        b.position.z = -300;
                    }
                });

                // Move Speed Lines
                if (speedLinesGroup) {
                    const pos = speedLinesGroup.geometry.attributes.position.array;
                    for (let i = 0; i < pos.length / 6; i++) {
                        pos[i * 6 + 2] += GAME_SPEED * 8;
                        pos[i * 6 + 5] += GAME_SPEED * 8;
                        if (pos[i * 6 + 2] > 10) {
                            pos[i * 6 + 2] = -150;
                            pos[i * 6 + 5] = -154;
                        }
                    }
                    speedLinesGroup.geometry.attributes.position.needsUpdate = true;
                }

                // Spawning Logic
                spawnGameElements();

                // Process Projectiles
                for (let i = projectiles.length - 1; i >= 0; i--) {
                    const p = projectiles[i];
                    p.position.z -= 4;

                    // Collision with Obstacles
                    for (let j = obstacles.length - 1; j >= 0; j--) {
                        const obs = obstacles[j];
                        if (p.position.distanceTo(obs.position) < 2.0) {
                            createExplosion(obs.position, 0xef4444);
                            scene.remove(obs);
                            obstacles.splice(j, 1);
                            scene.remove(p);
                            projectiles.splice(i, 1);
                            logJarvis('Hostile drone neutralized by repulsor fire.');
                            break;
                        }
                    }

                    if (p && p.position.z < -200) {
                        scene.remove(p);
                        projectiles.splice(i, 1);
                    }
                }

                // Process Obstacles (Drones/Debris)
                for (let i = obstacles.length - 1; i >= 0; i--) {
                    const obs = obstacles[i];
                    obs.position.z += GAME_SPEED * 3;
                    obs.rotation.x += 0.02;
                    obs.rotation.y += 0.03;

                    // Suit Collision Check
                    if (obs.position.distanceTo(ironManSuit.position) < 1.8) {
                        createExplosion(obs.position, 0xef4444);
                        scene.remove(obs);
                        obstacles.splice(i, 1);
                        takeDamage(25);
                        logJarvis('WARNING: Kinetic impact registered on hull!', 'text-red-400');
                    } else if (obs.position.z > 15) {
                        scene.remove(obs);
                        obstacles.splice(i, 1);
                    }
                }

                // Process Energy Cores
                for (let i = energyCores.length - 1; i >= 0; i--) {
                    const core = energyCores[i];
                    core.position.z += GAME_SPEED * 3;
                    core.rotation.y += 0.04;

                    // Collection Check
                    if (core.position.distanceTo(ironManSuit.position) < 2.0) {
                        playCoreCollectSound();
                        createExplosion(core.position, 0xf59e0b);
                        scene.remove(core);
                        energyCores.splice(i, 1);

                        // Replenish Energy & Health
                        powerEnergy = Math.min(100, powerEnergy + 25);
                        coresCollected++;
                        logJarvis('Arc energy core absorbed. Reserves restored +25%.', 'text-amber-400');
                    } else if (core.position.z > 15) {
                        scene.remove(core);
                        energyCores.splice(i, 1);
                    }
                }

                // Process Particle Systems
                for (let i = particleSystems.length - 1; i >= 0; i--) {
                    const ps = particleSystems[i];
                    const pos = ps.system.geometry.attributes.position.array;
                    ps.life -= 0.05;

                    for (let j = 0; j < ps.velocities.length; j++) {
                        pos[j * 3] += ps.velocities[j].x;
                        pos[j * 3 + 1] += ps.velocities[j].y;
                        pos[j * 3 + 2] += ps.velocities[j].z;
                    }
                    ps.system.geometry.attributes.position.needsUpdate = true;
                    ps.system.material.opacity = ps.life;

                    if (ps.life <= 0) {
                        scene.remove(ps.system);
                        particleSystems.splice(i, 1);
                    }
                }
            }

            renderer.render(scene, camera);
        }

        function takeDamage(amount) {
            health = Math.max(0, health - amount);
            document.getElementById('health-bar').style.width = `${health}%`;
            document.getElementById('health-val').innerText = `${health}%`;

            // Red Damage Screen Flash
            const flash = document.getElementById('flash-overlay');
            flash.className = 'absolute inset-0 pointer-events-none z-10 damage-flash';
            setTimeout(() => { flash.className = 'absolute inset-0 pointer-events-none z-10'; }, 300);

            if (health <= 0) {
                gameOver();
            }
        }

        function startGame() {
            initAudio();
            gameActive = true;
            isPaused = false;
            health = 100;
            powerEnergy = 100;
            distanceScore = 0;
            coresCollected = 0;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-over-screen').classList.add('hidden');
            logJarvis('Tactical HUD locked. Thrusters at full power.');
        }

        function togglePause() {
            if (!gameActive) return;
            isPaused = !isPaused;
            const btn = document.getElementById('pause-btn');
            if (isPaused) {
                btn.innerHTML = '<i class="fa-solid fa-play"></i> RESUME';
                logJarvis('Flight protocol suspended.', 'text-amber-400');
            } else {
                btn.innerHTML = '<i class="fa-solid fa-pause"></i> PAUSE';
                logJarvis('Resuming flight vector.');
            }
        }

        function gameOver() {
            gameActive = false;
            document.getElementById('final-score').innerText = `${distanceScore} m`;
            document.getElementById('final-cores').innerText = `${coresCollected}`;
            document.getElementById('game-over-screen').classList.remove('hidden');
            logJarvis('CRITICAL ERROR: Armor breach imminent!', 'text-red-500');
        }

        function restartGame() {
            // Clear entities
            obstacles.forEach(o => scene.remove(o));
            energyCores.forEach(c => scene.remove(c));
            projectiles.forEach(p => scene.remove(p));
            obstacles = [];
            energyCores = [];
            projectiles = [];

            // Reset UI
            document.getElementById('health-bar').style.width = '100%';
            document.getElementById('health-val').innerText = '100%';
            document.getElementById('power-bar').style.width = '100%';
            document.getElementById('power-val').innerText = '100%';

            startGame();
        }

        // Initialize Three.js on page load
        window.onload = () => {
            initThreeJS();
        };
    </script>
</body>
